# Sistema El Cuache (PWA) · cabeceras para que las actualizaciones lleguen al instante

# Tipos correctos
AddType application/manifest+json .webmanifest
AddType text/javascript .js .mjs
AddType image/webp .webp

<IfModule mod_headers.c>
    # Service worker, página principal y manifest: el navegador siempre pregunta
    # si hay versión nueva (si se guardaran 7 días, el aviso "Actualizar" tardaría días)
    <FilesMatch "^(sw\.js|registerSW\.js|index\.html|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    # Archivos con huella en el nombre (assets/*-AbC123.js, workbox-xxxx.js): no cambian nunca
    <FilesMatch "(-[A-Za-z0-9_-]{8}\.(js|css|woff2)|^workbox-[a-f0-9]{8}\.js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

# El listado de la carpeta no se muestra
Options -Indexes
